# Python overlay verbs — picked up by the base justfile's `import?`. Base
# verbs (lint, adr, format, token-cost) live in justfile.base; never add
# them here.

# Run the test suite.
test *args:
    uv run pytest {{ args }}

# Type-check the project.
typecheck:
    uv run pyright

# Format Python sources with ruff — named `fmt`, not `format`: justfile.base
# now owns that recipe name for markdown (pst#149).
fmt *args:
    uv run ruff format {{ args }}
